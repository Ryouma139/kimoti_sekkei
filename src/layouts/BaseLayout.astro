---
import '../styles/global.css';
import MoodBlob from '../components/MoodBlob.astro';
import { todayJST } from '../lib/dates';
import { url } from '../lib/url';

type Section = 'home' | 'calendar' | 'feel' | 'tech' | 'learn' | 'about';

interface Props {
  title?: string;
  description?: string;
  current?: Section;
  /** 検索エンジンに載せない（管理画面など） */
  noindex?: boolean;
  /** 管理画面のページ。これ以外のページを開くと、保存しないを選んだトークンを消す */
  admin?: boolean;
}

const SITE = 'きもちとコード';
const { title, description = 'きもちと学びを記録する、エンジニアの日記。', current, noindex, admin } = Astro.props;
const pageTitle = title ? `${title} | ${SITE}` : SITE;

const NAV: { key: Section; href: string; label: string; color: string }[] = [
  { key: 'home', href: '/', label: 'ホーム', color: 'var(--fg)' },
  { key: 'calendar', href: `/calendar/${todayJST().slice(0, 4)}/`, label: 'カレンダー', color: 'var(--m-meh)' },
  { key: 'feel', href: '/feel/', label: 'きもち日記', color: 'var(--feel)' },
  { key: 'tech', href: '/tech/', label: 'テックノート', color: 'var(--tech)' },
  { key: 'learn', href: '/learn/', label: 'まなびログ', color: 'var(--learn)' },
  { key: 'about', href: '/about/', label: 'このサイトについて', color: 'var(--accent)' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body data-admin={admin ? '' : undefined}>
    <div class="app">
      <aside class="side">
        <a class="brand" href={url('/')}>
          <MoodBlob mood="happy" size="38px" />
          <div>{SITE}<small>ENGINEER DIARY</small></div>
        </a>
        <nav class="nav" aria-label="メイン">
          {
            NAV.map((n) => (
              <a href={url(n.href)} style={`--c:${n.color}`} aria-current={n.key === current ? 'page' : undefined}>
                <span class="dot" />
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="side-note">
          <p>気分・技術・学びを分けて記録しています。</p>
          <a class="side-admin" href={url('/admin/')}>→ 管理画面はこちら</a>
        </div>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import { forgetSessionToken } from '../lib/admin-client';

  // 管理画面の外のページを開いたら、トークン（「このブラウザに保存する」をオフにしたもの）を消す
  if (!document.body.hasAttribute('data-admin')) forgetSessionToken();
</script>
