---
// 管理画面の「保存記事一覧」：下書きも含めて、src/content にある記事（Markdown）を全部出す。
// 一覧はビルド時点のもの。管理画面で保存した直後の記事は、自動デプロイが終わると載る。
import AdminShell from '../../components/AdminShell.astro';
import { getAllForAdmin, KIND_LABEL } from '../../lib/data';
import { BRANCH, REPO } from '../../lib/admin-client';
import { dotted, ymd } from '../../lib/dates';
import { url } from '../../lib/url';

type Kind = keyof typeof KIND_LABEL;

const all = await getAllForAdmin();
const toRow = (kind: Kind, e: { id: string; filePath?: string; data: { title: string; date: Date; draft: boolean } }) => {
  const filePath = e.filePath ?? `src/content/${kind}/${e.id}.md`;
  const encoded = filePath.split('/').map(encodeURIComponent).join('/');
  return {
    kind,
    id: e.id,
    title: e.data.title,
    date: dotted(ymd(e.data.date)),
    draft: e.data.draft,
    filePath,
    // 下書きはサイトにページがないので、サイトへのリンクは出さない
    siteHref: e.data.draft ? undefined : url(kind === 'learn' ? `/learn/#${e.id}` : `/${kind}/${e.id}/`),
    adminEditHref: url(`/admin/${kind}/?edit=${encodeURIComponent(filePath)}`),
    editHref: `https://github.com/${REPO}/edit/${BRANCH}/${encoded}`,
  };
};
const rows = [
  ...all.feel.map((e) => toRow('feel', e)),
  ...all.learn.map((e) => toRow('learn', e)),
  ...all.tech.map((e) => toRow('tech', e)),
];
const draftCount = rows.filter((r) => r.draft).length;
const KINDS: Kind[] = ['feel', 'learn', 'tech'];
---

<AdminShell
  title="保存記事一覧"
  eyebrow="ADMIN ／ POSTS"
  color="var(--accent)"
  lead="リポジトリにある記事（Markdown）を、下書きも含めてすべて表示します。直すときは「管理画面で修正」か「GitHubで編集」から（トークン設定時のみ表示）。"
  section="posts"
  tokenWarning={false}
>
  <div class="post-filters">
    <div class="pill-tabs" role="group" aria-label="種類で絞り込む" data-filter-group="kind">
      <button type="button" data-value="" aria-pressed="true">すべて（{rows.length}）</button>
      {
        KINDS.map((k) => (
          <button type="button" data-value={k} aria-pressed="false">
            {KIND_LABEL[k]}（{rows.filter((r) => r.kind === k).length}）
          </button>
        ))
      }
    </div>
    <div class="pill-tabs" role="group" aria-label="状態で絞り込む" data-filter-group="status">
      <button type="button" data-value="" aria-pressed="true">公開・下書きすべて</button>
      <button type="button" data-value="published" aria-pressed="false">公開中（{rows.length - draftCount}）</button>
      <button type="button" data-value="draft" aria-pressed="false">下書き（{draftCount}）</button>
    </div>
    <p class="filename">
      <span data-post-count>{rows.length}</span>件を表示中 ・ この一覧はサイトをビルドした時点のものです（保存直後の記事は、自動デプロイが終わると載ります）
    </p>
    <p class="filename" data-edit-hint hidden>
      「管理画面で修正」「GitHubで編集」は、GitHub トークンを設定しているときだけ表示します。<a href={url('/admin/')}>記事を書く</a>で設定してください。
    </p>
  </div>

  <ul class="post-list">
    {
      rows.map((r) => (
        <li class:list={['post-item', { 'is-draft': r.draft }]} data-kind={r.kind} data-status={r.draft ? 'draft' : 'published'}>
          <div>
            <div class="t">{r.title}</div>
            <div class="m">
              <span class:list={['kind', r.kind]}>{KIND_LABEL[r.kind]}</span>
              {r.draft && <span class="draft-badge">下書き</span>}
              <span>{r.date}</span>
              <code>{r.filePath}</code>
            </div>
          </div>
          <div class="links">
            {r.siteHref && <a href={r.siteHref}>サイトで見る</a>}
            <a href={r.adminEditHref} data-edit-link hidden>
              管理画面で修正
            </a>
            <a href={r.editHref} target="_blank" rel="noopener" data-edit-link hidden>
              GitHubで編集
            </a>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="empty-note" data-post-empty hidden>この条件の記事はありません。</p>
</AdminShell>

<script>
  import { getToken } from '../../lib/admin-client';

  // 「管理画面で修正」「GitHubで編集」はトークンを設定しているときだけ出す（設定していなければ案内を出す）
  // 戻るボタンでキャッシュから表示されたときも、今のトークンの有無に合わせる
  const showEditLinks = () => {
    const hasToken = Boolean(getToken());
    document.querySelectorAll<HTMLElement>('[data-edit-link]').forEach((a) => (a.hidden = !hasToken));
    const hint = document.querySelector<HTMLElement>('[data-edit-hint]');
    if (hint) hint.hidden = hasToken;
  };
  showEditLinks();
  window.addEventListener('pageshow', showEditLinks);

  // 種類・状態のボタンで絞り込む（並べ替えはせず、条件に合わない行を隠す）
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const count = document.querySelector('[data-post-count]');
  const empty = document.querySelector<HTMLElement>('[data-post-empty]');
  const selected: Record<string, string> = { kind: '', status: '' };

  const apply = () => {
    let shown = 0;
    items.forEach((item) => {
      item.hidden = (selected.kind !== '' && item.dataset.kind !== selected.kind) || (selected.status !== '' && item.dataset.status !== selected.status);
      if (!item.hidden) shown++;
    });
    if (count) count.textContent = String(shown);
    if (empty) empty.hidden = shown > 0;
  };

  document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
    const buttons = group.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        selected[group.dataset.filterGroup!] = button.dataset.value ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        apply();
      });
    });
  });
</script>
