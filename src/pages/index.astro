---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoodBlob from '../components/MoodBlob.astro';
import MoodCalendar from '../components/MoodCalendar.astro';
import FeedRow from '../components/FeedRow.astro';
import { feelItem, getFeel, getLearn, getTech, itemsByDay, learnItem, minutesByDay, moodByDay, studyStreak, techItem, type FeedItem } from '../lib/data';
import { dotted, todayJST, weekday, ymd } from '../lib/dates';
import { MOODS } from '../lib/moods';
import { url } from '../lib/url';

const [feel, tech, learn] = await Promise.all([getFeel(), getTech(), getLearn()]);
const today = todayJST();
const byDay = minutesByDay(learn);
const totalMinutes = learn.reduce((s, e) => s + e.data.minutes, 0);
const latest = feel[0];
const activeProjects = tech.filter((e) => e.data.type === 'project' && e.data.status === 'run').length;

// 3種類の記録を新しい順に混ぜる（種類ごとに最大5件 → 上位5件）。同じ日なら feel を先に、その次は書いた日時が新しい順
const FEED_SIZE = 5;
const feed: FeedItem[] = [
  ...feel.slice(0, FEED_SIZE).map(feelItem),
  ...learn.slice(0, FEED_SIZE).map(learnItem),
  ...tech.slice(0, FEED_SIZE).map((e) => techItem(e)),
]
  .sort(
    (a, b) =>
      b.date.getTime() - a.date.getTime() ||
      Number(b.kind === 'feel') - Number(a.kind === 'feel') ||
      (b.created?.getTime() ?? 0) - (a.created?.getTime() ?? 0),
  )
  .slice(0, FEED_SIZE);
---

<BaseLayout current="home">
  <section class="view">
    <div class="hero">
      {
        latest ? (
          <a class="today" href={url(`/feel/${latest.id}/`)}>
            <span class="eyebrow">
              最新の気分 ・ {dotted(ymd(latest.data.date))} {weekday(ymd(latest.data.date))}
            </span>
            <div class="today-main">
              <MoodBlob mood={latest.data.mood} size="88px" />
              <div>
                <p class="q">{MOODS[latest.data.mood].label}</p>
                <h2>{latest.data.title}</h2>
              </div>
            </div>
          </a>
        ) : (
          <div class="today">
            <span class="eyebrow">{dotted(today)}</span>
            <h2>きょうの気分は？</h2>
            <p class="q">src/content/feel/ に最初の日記を書くと、ここに表示されます。</p>
          </div>
        )
      }
      <div class="stats">
        <div class="stat learn"><b class="num">{Math.floor(totalMinutes / 60)}h</b><span>累計スタディタイム</span></div>
        <div class="stat learn"><b class="num">{studyStreak(byDay, today)}日</b><span>連続学習ストリーク</span></div>
        <div class="stat feel"><b class="num">{feel.length}</b><span>きもち日記</span></div>
        <div class="stat tech"><b class="num">{activeProjects}</b><span>進行中のプロジェクト</span></div>
      </div>
    </div>

    <div class="grid2">
      <div class="panel">
        <h2>きもちカレンダー</h2>
        <MoodCalendar moods={moodByDay(feel)} minutes={byDay} today={today} items={itemsByDay(feel, tech, learn)} />
      </div>
      <div class="panel">
        <h2>最近の記録</h2>
        <div class="feed">
          {feed.length === 0 && <p class="empty-note">まだ記録がありません。</p>}
          {
            feed.map((item) => <FeedRow item={item} />)
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
