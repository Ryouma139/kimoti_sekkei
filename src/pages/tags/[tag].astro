---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoodBlob from '../../components/MoodBlob.astro';
import { allTags, getFeel, getLearn, getTech } from '../../lib/data';
import { dotted, ymd } from '../../lib/dates';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const [feel, tech, learn] = await Promise.all([getFeel(), getTech(), getLearn()]);
  return allTags(feel, tech, learn).map((tag) => ({
    params: { tag },
    props: {
      tag,
      items: [
        ...feel
          .filter((e) => e.data.tags.includes(tag))
          .map((e) => ({ kind: 'feel' as const, date: e.data.date, title: e.data.title, href: `/feel/${e.id}/`, mood: e.data.mood })),
        ...tech
          .filter((e) => e.data.tags.includes(tag))
          .map((e) => ({ kind: 'tech' as const, date: e.data.date, title: e.data.title, href: `/tech/${e.id}/`, mood: undefined })),
        ...learn
          .filter((e) => e.data.tags.includes(tag))
          .map((e) => ({ kind: 'learn' as const, date: e.data.date, title: e.data.title, href: `/learn/#${e.id}`, mood: undefined })),
      ].sort((a, b) => b.date.getTime() - a.date.getTime()),
    },
  }));
}

const { tag, items } = Astro.props;
const KIND = { feel: 'きもち', tech: 'テック', learn: 'まなび' } as const;
---

<BaseLayout title={`#${tag}`}>
  <section class="view">
    <div class="head">
      <span class="eyebrow">TAG</span>
      <h1>#{tag}</h1>
      <p>{items.length}件の記録</p>
    </div>
    <div class="feed">
      {
        items.map((item) => (
          <a class="row" href={url(item.href)}>
            {item.mood ? <MoodBlob mood={item.mood} size="44px" /> : <span class="ico" style={`background:var(--${item.kind})`} />}
            <div>
              <div class="t">{item.title}</div>
              <div class="m num">{dotted(ymd(item.date))}</div>
            </div>
            <span class:list={['kind', item.kind]}>{KIND[item.kind]}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
